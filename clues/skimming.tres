[ext_resource type="Script" path="res://exploration/ClueDefinition.gd" id="1_clue"]

[resource]
script = ExtResource("1_clue")
title = "Ten crates missing"
text = "Forty crates came in, and the captain will only own to thirty. Ten crates of lamp oil are going somewhere - and he knows where."
from_clues = Array[String](["ledger_count", "captain_claim"])
