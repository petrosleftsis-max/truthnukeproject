; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Messengers of Truth"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://art/app_icon/icon.png"

[autoload]

SkillDatabase="*res://data/databases/skill_database.gd"
ItemDatabase="*res://data/databases/item_database.gd"
CombatantDatabase="*res://data/databases/combatant_database.gd"
Campaign="*res://campaign/Campaign.gd"
Music="*res://audio/Music.gd"
SceneTransition="*res://ui/scene_transition.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
Actors="*res://exploration/Actors.gd"
Pictures="*res://exploration/Pictures.gd"
Journal="*res://ui/journal.gd"
Hacking="*res://hacking/Hacking.gd"
QuickTime="*res://quicktime/QuickTime.gd"
Pad="*res://control/Pad.gd"
Coop="*res://multiplayer/Coop.gd"
Pings="*res://multiplayer/Pings.gd"
Net="*res://multiplayer/Net.gd"

[dialogue_manager]

runtime/state_autoload_shortcuts=PackedStringArray("Campaign", "Music", "Actors", "Pictures", "Journal", "Hacking", "QuickTime")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=false
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[file_customization]

folder_colors={
"res://art/": "purple",
"res://audio/": "pink",
"res://data/": "blue",
"res://demos/": "teal",
"res://dialogue/": "yellow",
"res://maps/": "green",
"res://pictures/": "orange",
"res://scenes/": "red",
"res://tools/": "gray"
}

[gui]

theme/custom="res://ui/blue_theme.tres"

