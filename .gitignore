# Godot 4+ specific ignores
.godot/

# Editor backup files (e.g. art/chars.png~)
*~

# Godot-specific ignores
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json
# Export output
builds/
export/
export.zip
*-web.zip
*-windows.zip
*-linux.tar.gz
*-macos.zip

# Music sources. Three WAVs, 126 MB between them, and nothing in the game
# depends on their being here: Music.gd warns and carries on in silence when a
# track is missing, so a clone without them plays fine and fights quietly.
# The sound effects stay tracked - they are 6 MB for the lot and every skill
# uses one.
audio/music/*.wav
audio/music/*.wav.import

# The designer's sounds and the ambience: kept on their own drive, over 3 GB of them. tools/place_sfx.ps1 puts
# them where the game uses them. Their .import files stay tracked, with how each is imported. A clone
# without them plays on in silence (SkillDatabase: set_abort_on_missing_resources).
audio/sfx/New folder/
audio/sfx/fights/*.wav
audio/sfx/moves/*.wav
audio/sfx/world/*.wav
audio/sfx/menus/*.wav
audio/ambience/

# A local backup of the audio, kept beside the project. 177 MB, and the whole
# point of ignoring the music is not to carry it around.
audio.zip
