[resource]
script = ExtResource("2_fhab5")
display_name = "Hired Blades"
description = "A pit champion and the sellswords who follow it. Stand near the champion and you fight nobody else. Mercenaries can be paid off, talked round with the contract, or broken - bring the champion down and the rest lose heart. Whoever breaks runs for a way out; whoever is taken alive is yours to deal with when it is over."
terrain_scene = ExtResource("4_x4df1")
victory_dialogue = ExtResource("5_after")
dialogue_decides_prisoners = true
spawns = Array[ExtResource("3_ex5ow")]([SubResource("Resource_x6mhy"), SubResource("Resource_j1f8v"), SubResource("Resource_l7x2j"), SubResource("Resource_j5gq1"), SubResource("Foe_1"), SubResource("Foe_2"), SubResource("Foe_3"), SubResource("Foe_4"), SubResource("Foe_5")])
escape_points = Array[Vector2i]([Vector2i(2, 1), Vector2i(52, 12)])
