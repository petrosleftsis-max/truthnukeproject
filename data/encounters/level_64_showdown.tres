[resource]
script = ExtResource("1_enc")
display_name = "Sixty-Four"
description = "Everybody at level 64, the party on their paths - Enfina a Juggernaut, Cyrus a Trapper, Prometheus an Elemental Conductor, Alithia an Illusory Shepherd - against the strongest of everyone they have fought. Change a path on its spawn to try another."
terrain_scene = ExtResource("3_city")
spawns = Array[ExtResource("2_spawn")]([SubResource("Party_prometheus"), SubResource("Party_alithia"), SubResource("Party_enfina"), SubResource("Party_cyrus"), SubResource("Foe_ranger_1"), SubResource("Foe_summoner"), SubResource("Foe_barbarian"), SubResource("Foe_sorcerer_1"), SubResource("Foe_sorcerer_2"), SubResource("Foe_priest_1"), SubResource("Foe_champion"), SubResource("Foe_priest_2"), SubResource("Foe_ranger_2")])
music = "Luce_del_Desiderio"
