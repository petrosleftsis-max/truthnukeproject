[resource]
script = ExtResource("1_enc")
boss_reveal = true
display_name = "Erysichthon"
description = "A boss: Erysichthon, the hunger that ate itself. Whatever it bites it drains, and what it devours - strength, spells, the first thing you have ready - goes into its belly; tear the belly open and all of it comes back. It eats from Demeter's sacred trees to heal: they burn easily. Gnawers come in waves: on round 3, when its belly first breaks, and once three of its side have fallen."
terrain_scene = ExtResource("3_map")
spawns = Array[ExtResource("2_spawn")]([SubResource("Spawn_enfina"), SubResource("Spawn_alithia"), SubResource("Spawn_cyrus"), SubResource("Spawn_prometheus"), SubResource("Spawn_glutton"), SubResource("Spawn_tree_a"), SubResource("Spawn_tree_b"), SubResource("Spawn_tree_c"), SubResource("Spawn_tree_d"), SubResource("Spawn_wave1_a"), SubResource("Spawn_wave1_b"), SubResource("Spawn_wave2_a"), SubResource("Spawn_wave2_b"), SubResource("Spawn_wave3_a"), SubResource("Spawn_wave3_b")])
music = "Mehul ShaRma - CURSE"
