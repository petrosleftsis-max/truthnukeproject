[resource]
script = ExtResource("1_enc")
display_name = "Two Floors"
description = "Heights: a gallery over the floor, reached by two sets of stairs (the ladders under it), and barrels to climb from beside them. Archers shoot down from the gallery through the open air, and nobody under it can be seen from up there. Up on high ground or on the gallery, low things are no cover - either way. Page Up / Page Down (L3) or the floor buttons show the other floor."
terrain_scene = ExtResource("4_map")
spawns = Array[ExtResource("2_spawn")]([SubResource("Spawn_enfina"), SubResource("Spawn_cyrus"), SubResource("Spawn_alithia"), SubResource("Spawn_prometheus"), SubResource("Spawn_bow_a"), SubResource("Spawn_bow_b"), SubResource("Spawn_ranger"), SubResource("Spawn_sword")])
music = "Scott Buckley - Filaments"
escape_points = Array[Vector2i]([Vector2i(1, 14), Vector2i(20, 14)])
climb_points = Array[Vector2i]([Vector2i(5, 9), Vector2i(13, 8), Vector2i(19, 10), Vector2i(2, 4)])
floors = Array[ExtResource("3_floor")]([SubResource("Floor_ground"), SubResource("Floor_gallery")])
