[resource]
script = ExtResource("1_enc")
display_name = "The Summoner"
description = "A Summoner keeps well back and sends its Bound Beast in - mending it, empowering it, and calling another if it falls. The beast hits harder than a barbarian once empowered; the Summoner is frailer than a sorcerer. Fell the Summoner and the beast goes with it."
terrain_scene = ExtResource("3_map")
spawns = Array[ExtResource("2_spawn")]([SubResource("Spawn_enfina"), SubResource("Spawn_alithia"), SubResource("Spawn_cyrus"), SubResource("Spawn_prometheus"), SubResource("Spawn_summoner"), SubResource("Spawn_bow")])
