[resource]
script = ExtResource("1_enc")
display_name = "The Alchemist"
description = "An Alchemist hung with a dozen bottles, bombs and Gate Nades keeps a Sellsword and an archer on their feet and throws the rest at you, two things a turn. Every item and piece of gear on the enemy can be looted off them once they are down - Loot, a secondary action beside a body, or Search the fallen after the fight."
