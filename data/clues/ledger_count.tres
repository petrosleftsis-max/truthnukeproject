[ext_resource type="Script" path="res://exploration/ClueDefinition.gd" id="1_clue"]

[resource]
script = ExtResource("1_clue")
title = "The ledger's count"
text = "The quartermaster's ledger, in his neat hand: forty crates of lamp oil came in this month, signed for."

