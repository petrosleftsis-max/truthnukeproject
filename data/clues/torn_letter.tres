[ext_resource type="Script" path="res://exploration/ClueDefinition.gd" id="1_clue"]

[resource]
script = ExtResource("1_clue")
title = "The torn letter"
text = "'...thirty crates on the books, whatever the ledger says. The rest goes out by the ditch after the bell. Burn this. - V.'"

