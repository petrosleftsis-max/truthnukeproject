[resource]
script = ExtResource("5_comb")
name = "Erysichthon"
glossary_text = "An undead wolf grown to an abomination, that never stops eating and is never full: whatever it swallows falls out through the hole in its belly. It catches the scent of its prey, grabs it, and swallows it whole - and it eats anything it finds in reach, even its own."
max_hp = 300
max_hp_level_20 = 2100
size = 4
movement = 7
initiative = 4
sprite_frames = ExtResource("7_frames")
tint = Color(0.62, 0.72, 0.52, 1)
skills = Array[String](["ravenous_bite", "grab", "devour", "catch_the_scent", "rending_claws"])
passives = Array[ExtResource("9_passive")]([ExtResource("10_hollow")])
resist_fire = -25
immune_to = Array[int]([9, 10, 12])
boss = SubResource("Boss")
parts = Array[ExtResource("4_part")]([SubResource("Part_jaws"), SubResource("Part_belly"), SubResource("Part_legs")])
eats = 3
meal_heals = 0.06
fed_effects = Array[ExtResource("6_effect")]([SubResource("Effect_gorged")])
spat_out_with = ExtResource("8_bile")
ai_function = "ai_glutton"
