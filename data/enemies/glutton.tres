[sub_resource type="Resource" id="Set_second"]
script = ExtResource("6_set")
skills = Array[String](["claw", "claw", "chomp"])
reach = 6
lunges = true
another_target = true

[sub_resource type="Resource" id="Phase_famished"]
script = ExtResource("1_phase")
name = "Famished"
message = "Half eaten by its own hunger, it opens its jaws wider than its body - and it is hungry for all of you."
skills_added = Array[String](["feast"])
attack_sets_added = Array[ExtResource("6_set")]([SubResource("Set_second")])

[sub_resource type="Resource" id="Phase_insatiable"]
script = ExtResource("1_phase")
name = "Insatiable"
at_health = 0.25
message = "Nothing is left of it but the hunger."
unlimited_skills = Array[String](["feast"])

[sub_resource type="Resource" id="Stagger_bar"]
script = ExtResource("14_stagger")
hint = "Hit it hard, and try on it what it shrugs off. Staggered, it heaves up whoever it has swallowed, and is hit harder until whoever staggered it acts again."
max_value = 150.0
per_damage = 0.6
per_blocked_condition = 15.0
harder_until = 1

[sub_resource type="Resource" id="Boss"]
script = ExtResource("3_boss")
stagger = SubResource("Stagger_bar")
title = "The Hunger That Ate Itself"
reveal_sound = ExtResource("sfx_phase_sound")
reveal_second_sound = ExtResource("sfx_reveal_second_sound")
phase_sound = ExtResource("sfx_phase_sound")
phases = Array[ExtResource("1_phase")]([SubResource("Phase_famished"), SubResource("Phase_insatiable")])
codex_second_page = "A king once, who cut down Demeter's grove; she gave him a hunger nothing fills. Whatever it bites, it drains, and whatever it devours - strength, spells, what you carry - stays in its belly. Tear the belly open and all of it comes back."

[sub_resource type="Resource" id="Part_belly"]
script = ExtResource("4_part")
name = "Belly"
tiles = Array[Vector2i]([Vector2i(0, 2), Vector2i(1, 2), Vector2i(0, 3), Vector2i(1, 3)])
when_broken = 5
frees_the_swallowed = true

[resource]
script = ExtResource("5_comb")
name = "Erysichthon"
glossary_text = "An undead wolf grown to an abomination, that never stops eating and is never full. Whatever it bites, it drains; whatever it devours - strength, spells, the things you carry - goes into its belly, where it can be torn back out."
max_hp = 300
max_hp_level_20 = 2100
size = 4
movement = 8
initiative = 6
sprite_frames = ExtResource("7_frames")
tint = Color(0.62, 0.72, 0.52, 1)
skills = Array[String](["claw", "chomp", "gate_devour"])
passives = Array[ExtResource("9_passive")]([ExtResource("10_hollow"), ExtResource("11_vitality"), ExtResource("12_immunities"), ExtResource("13_starving")])
resist_fire = 100
resist_earth = 100
resist_poison = -25
reactions_per_round = 3
attack_sets = Array[ExtResource("6_set")]([SubResource("Set_first")])
boss = SubResource("Boss")
parts = Array[ExtResource("4_part")]([SubResource("Part_belly")])
feeds_with = Array[String](["claw"])
belly_prize = Array[String](["potent_cure_potion", "big_bomb", "wildfire_gate_nade"])
ai_function = "ai_attack_sets"
ai_smarts = 2
ai_never_knows = 4
