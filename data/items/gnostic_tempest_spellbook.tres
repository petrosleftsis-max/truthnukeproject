[resource]
script = ExtResource("1_item")
name = "Gnostic Tempest Spellbook"
description = "A spellbook of Gnostic Tempest. Prometheus can learn Gnostic Tempest from it - on the Moves page of his character sheet, between fights - and it is used up as he does."
