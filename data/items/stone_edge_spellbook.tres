[resource]
script = ExtResource("1_item")
name = "Stone Edge Spellbook"
description = "A spellbook of Stone Edge. Prometheus can learn Stone Edge from it - on the Moves page of his character sheet, between fights - and it is used up as he does."
icon = ExtResource("2_icon")
can_be_copied = false
deals_damage = false
price = 375
teaches = "stone_edge"
