[resource]
script = ExtResource("1_item")
name = "Turn Aside Spellbook"
description = "A spellbook of Turn Aside. Prometheus can learn Turn Aside from it - on the Moves page of his character sheet, between fights - and it is used up as he does."
icon = ExtResource("2_icon")
