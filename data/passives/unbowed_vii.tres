[resource]
script = ExtResource("1_passive")
name = "Unbowed VII"
description = "She does not bend: she cannot be afraid, confused or compelled, blinded, deafened, dazed or stunned, and no ash chokes her."
required_level = 56
immune_to_conditions = Array[ExtResource("2_condition")]([ExtResource("3_stunned")])
