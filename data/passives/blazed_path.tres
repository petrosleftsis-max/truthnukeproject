[gd_resource type="Resource" script_class="PassiveDefinition" format=3]

[ext_resource type="Script" path="res://combat/resources/PassiveDefinition.gd" id="1_passive"]

[resource]
script = ExtResource("1_passive")
name = "Blazed Path"
description = "While she burns, every tile she walks in her turn stays alight until her next turn. Her side walks onto those tiles for one movement a tile, never double - not even when hemmed in, or in snow or tar - and anybody of her side who starts a turn on one gets +1 movement that turn. The other side catches fire stepping onto one."
required_level = 8
blazes_a_path = true
