[resource]
script = ExtResource("1_passive")
name = "Unbowed V"
description = "She does not bend: she cannot be afraid, confused or compelled, blinded, deafened or dazed."
required_level = 33
immune_to_conditions = Array[ExtResource("2_condition")]([ExtResource("3_dazed")])
