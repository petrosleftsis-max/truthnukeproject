[gd_resource type="Resource" script_class="PassiveDefinition" format=3]

[ext_resource type="Script" path="res://combat/resources/PassiveDefinition.gd" id="1_passive"]
[ext_resource type="Script" path="res://combat/resources/ConditionDefinition.gd" id="2_condition"]
[ext_resource type="Resource" path="res://data/conditions/blind.tres" id="3_blind"]
[ext_resource type="Resource" path="res://data/conditions/deafened.tres" id="4_deafened"]

[resource]
script = ExtResource("1_passive")
name = "Unbowed IV"
description = "She does not bend: she cannot be afraid, confused or compelled, blinded or deafened."
required_level = 24
immune_to_conditions = Array[ExtResource("2_condition")]([ExtResource("3_blind"), ExtResource("4_deafened")])
