[gd_resource type="Resource" script_class="PassiveDefinition" format=3]

[ext_resource type="Script" path="res://combat/resources/PassiveDefinition.gd" id="1_passive"]

[resource]
script = ExtResource("1_passive")
name = "Devotion"
description = "Two castings of her own, for Heal or for Dread Visage on one person, spent before any gate. One comes back at a short rest, both at a long rest."
spare_castings = 2
spare_casting_spells = Array[String](["heal", "dread_visage"])
spare_castings_a_short_rest = 1
