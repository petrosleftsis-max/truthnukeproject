[gd_resource type="Resource" script_class="PassiveDefinition" format=3]

[ext_resource type="Script" path="res://combat/resources/PassiveDefinition.gd" id="1_passive"]

[resource]
script = ExtResource("1_passive")
name = "Breaker"
description = "Anything that can be broken breaks under any blow of hers at once, however much it would take anybody else: a barrel, a crate, a keg, a brazier, a Cracked Wall."
required_level = 1
breaks_things = true
