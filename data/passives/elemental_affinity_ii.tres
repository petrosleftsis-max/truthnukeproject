[gd_resource type="Resource" script_class="PassiveDefinition" format=3]

[ext_resource type="Script" path="res://combat/resources/PassiveDefinition.gd" id="1_passive"]

[resource]
script = ExtResource("1_passive")
name = "Elemental Affinity II"
description = "He knows what each element undoes: a tenth more damage on anybody weak to the element, and a tenth more on anybody already burning, frozen, poisoned - taking any lingering damage."
required_level = 32
bonus_vs_lingering = 0.1
