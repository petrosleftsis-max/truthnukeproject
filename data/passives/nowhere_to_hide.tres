[gd_resource type="Resource" script_class="PassiveDefinition" format=3]

[ext_resource type="Script" path="res://combat/resources/PassiveDefinition.gd" id="1_passive"]

[resource]
script = ExtResource("1_passive")
name = "Nowhere to Hide"
description = "Anybody of the other side standing in Bright within six tiles of her, in her sight, cannot hide, and is Exposed to her if they try."
required_level = 16
nowhere_to_hide_tiles = 6
