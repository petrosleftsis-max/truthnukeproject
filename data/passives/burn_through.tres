[gd_resource type="Resource" script_class="PassiveDefinition" format=3]

[ext_resource type="Script" path="res://combat/resources/PassiveDefinition.gd" id="1_passive"]

[resource]
script = ExtResource("1_passive")
name = "Burn Through"
description = "While she burns, she walks straight through anything that can be broken - a barrel, a crate, a keg, a Cracked Wall - and it breaks as she comes to it. A keg goes off, catching her too. Walls, rock and raised ground still stop her."
required_level = 4
burns_through = true
