[resource]
script = ExtResource("1_passive")
name = "Boss Immunities"
description = "Cannot be knocked prone, stunned, made to hesitate, confused, deceived, compelled, frightened, blinded, deafened or caught off guard; never breaks and flees, cannot be taken alive and cannot be thrown."
immune_to = Array[int]([9, 10, 12])
immune_to_conditions = Array[ExtResource("2_condition")]([ExtResource("3_prone"), ExtResource("4_stunned"), ExtResource("5_hesitating"), ExtResource("6_confused"), ExtResource("7_deceived"), ExtResource("8_compelled"), ExtResource("9_fear"), ExtResource("10_blind"), ExtResource("11_deafened"), ExtResource("12_off_guard")])
