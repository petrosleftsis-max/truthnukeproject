[ext_resource type="Resource" path="res://data/conditions/exposed.tres" id="1_exposed"]
[ext_resource type="Script" path="res://combat/resources/PassiveDefinition.gd" id="2_passive"]

[resource]
script = ExtResource("2_passive")
name = "Exposed"
description = "Turn away from a champion at your peril: anybody of the other side who ends a turn within two tiles of them without hurting them is Exposed - a fifth more from the champion until their next turn."
exposes_within = 2
exposes_with = ExtResource("1_exposed")
