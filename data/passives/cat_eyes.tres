[gd_resource type="Resource" script_class="PassiveDefinition" format=3]

[ext_resource type="Script" path="res://combat/resources/PassiveDefinition.gd" id="1_passive"]

[resource]
script = ExtResource("1_passive")
name = "Cat Eyes"
description = "He sees in the dark: nobody in darkness is invisible to him. And he aims low: an enemy lying prone gets no cover from his ranged moves."
sees_in_darkness = true
ignores_prone_cover = true
