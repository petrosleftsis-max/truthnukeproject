[resource]
script = ExtResource("1_cond")
display_name = "Phantom Wound"
tag = "Pw"
description = "A psychic wound they believe in, each turn. They weigh it again as each turn starts, with more doubt every time, and stop believing once their Mindfulness beats the caster's."
