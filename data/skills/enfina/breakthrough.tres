[resource]
script = ExtResource("2_skill")
name = "Breakthrough"
description = "A charge in a straight line, as far as she can walk. Anybody of the other side her size or smaller in the way is driven aside, hit for half the blow, their guard broken; somebody bigger stops her and takes the whole of it. Burning, she smashes through what breaks on the way, and leaves the way alight a tile wider each side."
required_level = 16
icon = ExtResource("3_icon")
min_range = 1
max_range = 1
ability_modifier = 1.0
melee = true
respects_blocking = false
can_be_copied = false
charges_through = true
charge_aside_share = 0.5
animation = "attack"
effects = Array[ExtResource("1_effect")]([SubResource("Effect_blow")])
