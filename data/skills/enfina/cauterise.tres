[resource]
script = ExtResource("2_skill")
name = "Cauterise"
description = "A secondary action, only while she burns: she closes it up. The Burn is over, she mends 4 and 6 more for each turn of it she had left, and any Poison or Corroded comes off."
required_level = 24
min_range = 0
max_range = 0
targets_ally = true
melee = true
is_secondary = true
deals_damage = false
icon = ExtResource("7_icon")
can_be_copied = false
needs_own_burn = true
ends_own_burn = true
lifts_from_user = Array[ExtResource("6_cond")]([ExtResource("3_poison"), ExtResource("4_corroded"), ExtResource("5_deep")])
effects = Array[ExtResource("1_effect")]([SubResource("Effect_mend")])
