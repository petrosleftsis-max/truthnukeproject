[resource]
script = ExtResource("3_skill")
name = "Grab"
description = "Take hold of somebody beside you - your size or smaller, or one size bigger at most - and keep them there: they cannot move until they spend their main action breaking free. Your Physical against theirs, the same as breaking free. Also a reaction: grab somebody as they leave your reach, and drag them back beside you."
min_range = 1
max_range = 1
icon = ExtResource("2_icon")
can_be_copied = false
lifts_sizes_above = 1
is_reactive = true
animation = "attack"
effects = Array[ExtResource("1_effect")]([SubResource("Effect_hold")])
deals_damage = false
