[resource]
script = ExtResource("3_skill")
name = "Illusory Cover"
description = "Cover that is not there, on a bare tile within six, for three of her turns. The other side takes it for a real barricade - it blocks their sight, whoever stands beside it is in cover to them, and they plan around it - but shots and blasts go straight through it, and they never learn it."
min_range = 1
max_range = 6
required_level = 24
can_be_copied = false
deals_damage = false
spell_slot_level = 3
icon = ExtResource("2_icon")
effects = Array[ExtResource("1_effect")]([SubResource("Effect_1")])
