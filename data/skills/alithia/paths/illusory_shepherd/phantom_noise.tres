script = ExtResource("3_skill")
name = "Phantom Noise"
description = "A sound out of nowhere, where she points. In a fight, every enemy there who loses to her Mindfulness turns aside as their next turn starts and walks towards it as far as they can, then carries on. On a map, every guard within ten tiles of it goes to look."
