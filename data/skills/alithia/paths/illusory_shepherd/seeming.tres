[resource]
script = ExtResource("3_skill")
name = "Seeming"
description = "An ally looks like one of the enemy. In a fight nobody notices them, wherever they walk, until they do anything at all. On a map the whole party looks like the guards there for five minutes, and passes as any disguise does."
max_range = 6
