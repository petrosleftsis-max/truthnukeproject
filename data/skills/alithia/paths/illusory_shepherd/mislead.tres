[resource]
script = ExtResource("3_skill")
name = "Mislead"
description = "She fades from sight and a double of her stands where she points, for the other side to go after, and she can send it about with a secondary action. The invisibility ends when she does something to an enemy. The double stays until it is hit or dispelled. On a map: unseen for two minutes, with a double going on ahead for the guards to look at."
icon = ExtResource("2_icon")
effects = Array[ExtResource("1_effect")]([SubResource("Effect_0"), SubResource("Effect_1")])
