[resource]
script = ExtResource("3_skill")
name = "Phantom Wall"
description = "A wall up to five tiles long, from where she points first to where she points next, straight or diagonal, that only the other side believes in: they cannot see past it or walk through it. Her side shoots and walks straight through it, though nobody can stop on it. Whoever of the other side sees that happen sees through the wall and ignores it from then on, and so does anybody with more than instinct to go on, wherever they are. It lasts as long as she holds the tether."
min_range = 1
max_range = 8
icon = ExtResource("2_icon")
can_be_copied = false
effects = Array[ExtResource("1_effect")]([SubResource("Effect_0")])
deals_damage = false
impact_look = 19
spell_slot_level = 2
tethered = true
