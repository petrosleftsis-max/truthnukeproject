[resource]
script = ExtResource("3_skill")
name = "Fallen Friend"
description = "A reaction, when an enemy's blow would fell an ally in reach: it never lands. They go down and look dead to the other side, and nobody aims at them, for as long as she holds the tether and they do nothing. A step or a move gives it away, though a first blow from there comes from hiding, with nobody able to react to it."
icon = ExtResource("2_icon")
effects = Array[ExtResource("1_effect")]([SubResource("Effect_0")])
