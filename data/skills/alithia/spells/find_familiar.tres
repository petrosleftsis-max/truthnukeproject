[resource]
script = ExtResource("3_skill")
name = "Find Familiar"
description = "Outside a fight: a spirit takes the shape of whatever animal belongs where she is - a rat in the sewers, a cat in the streets, a raven out of doors - and she sees through its eyes and steers it while the party waits. It slips through gaps nobody else fits through, and a guard makes it out only close up; but it is magic, and a magic sensor knows it for what it is."
icon = ExtResource("2_icon")
effects = Array[ExtResource("1_effect")]([SubResource("Effect_familiar")])
deals_damage = false
scaling_stat = 1
spell_slot_level = 1
