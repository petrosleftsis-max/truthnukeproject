[resource]
script = ExtResource("3_skill")
name = "Beckoning Light"
description = "Aimed at one enemy, then at open ground in her reach, where a small light appears. If they lose to her Mindfulness, as their next turn starts they walk towards the light as far as they can, and arrive off their guard: no reactions until their next turn. On a map, through the Gates of Iris, a light leads a guard away from her for 20 seconds, his eyes on nothing else."
min_range = 1
max_range = 8
icon = ExtResource("2_icon")
effects = Array[ExtResource("1_effect")]([SubResource("Effect_0"), SubResource("Effect_light")])
deals_damage = false
can_be_copied = false
uses_stat_contest = true
contest_stat = 1
beckons = true
spell_slot_level = 2
outside_gate = 1
out_of_combat = true
outside_use = 24
