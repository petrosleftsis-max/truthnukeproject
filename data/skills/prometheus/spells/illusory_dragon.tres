[resource]
script = ExtResource("3_skill")
impact_look = 33
name = "Illusory Dragon"
description = "Shadow drawn out of the Ogdoad and given a dragon's shape, anywhere in reach. It stands where it stands like a living thing, but every blow misses it and nothing harms it; the other side near it is gripped by fear. Commanded, it flies and breathes a cone of whatever it is told to - fire, frost, lightning, poison, acid or dread - as strong as your own mind. It lasts as long as its tether to you holds."
min_range = 1
max_range = 12
icon = ExtResource("2_icon")
required_level = 47
can_be_copied = false
effects = Array[ExtResource("1_effect")]([SubResource("Effect_summon")])
deals_damage = false
spell_slot_level = 8
tethered = true
tether_strength = 100
tether_per_turn = 20
