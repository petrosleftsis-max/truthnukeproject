[resource]
script = ExtResource("3_skill")
name = "Great Snare"
description = "Only out of a fight. A great magical trap wherever he aims it, within six tiles. The first guard onto it, or standing there, sets it off: a fight starts, and before anybody's turn it hits everybody within three tiles of it for x1.2, and holds the one who stepped on it fast. Not a sound as it is laid; everybody hears it go."
