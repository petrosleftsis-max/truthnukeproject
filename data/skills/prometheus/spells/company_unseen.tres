script = ExtResource("3_skill")
name = "Company Unseen"
description = "Only out of a fight. Everybody but Cyrus is invisible and walks in his footsteps; only magic and noses find them, and the guards' eyes reach less far while it lasts. Whoever does not play Cyrus has the familiar."
