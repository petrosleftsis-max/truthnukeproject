[sub_resource type="Resource" id="Effect_dispel"]
script = ExtResource("1_effect")
type = 35

[resource]
script = ExtResource("3_skill")
name = "Dispel Magic"
description = "Undo magic: everything spells did to the one it lands on - theirs or the other side's, blessing or curse - or a spell's zone, aimed at its ground. Cast through Pandora's gate it reaches what came through Pandora's or a shallower one; cast through a deeper gate, deeper. Something a spell called up or made is undone with it."
max_range = 10
icon = ExtResource("2_icon")
affects_both_sides = true
can_be_copied = false
chooses_gate = true
effects = Array[ExtResource("1_effect")]([SubResource("Effect_dispel")])
deals_damage = false
impact_look = 24
spell_slot_level = 3
outside_use = 9
