[sub_resource type="Resource" id="Passive_0"]
script = ExtResource("1_passive")
name = "Righteous"
description = "Her damaging spells heal the most hurt of her side within two tiles of her for a fifth of the damage they did."
required_level = 54
righteous_share = 0.2
righteous_reach = 2

[sub_resource type="Resource" id="Passive_1"]
script = ExtResource("1_passive")
name = "Crusade"
description = "Allies within two tiles of her hit 15% harder."
required_level = 64
crusade_bonus = 0.15
crusade_reach = 2

[resource]
script = ExtResource("2_path")
name = "Battle Chaplain"
description = "Holy weapons. Alithia takes the fight to them with spear, sweep and hammer of light - and what she deals, her friends are mended by."
skills = Array[String](["holy_spear", "censure", "judgement_hammer"])
passives = Array[ExtResource("1_passive")]([SubResource("Passive_0"), SubResource("Passive_1")])
