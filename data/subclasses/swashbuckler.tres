[sub_resource type="Resource" id="Passive_0"]
script = ExtResource("1_passive")
name = "Riposte Step"
description = "After a Rapier strike lands, Cyrus can step up to two tiles away in a straight line - in whichever direction he likes - and nothing can react to it."
required_level = 5
step_after = Array[String](["rapier"])
step_tiles = 2

[resource]
script = ExtResource("2_path")
name = "Swashbuckler"
description = "A melee focused specialization, Cyrus learns to wield the rapier with impeccable swiftness and precision."
passives = Array[ExtResource("1_passive")]([SubResource("Passive_0")])
