[gd_resource type="Resource" script_class="SubclassDefinition" format=3]

[ext_resource type="Script" path="res://combat/resources/PassiveDefinition.gd" id="1_passive"]
[ext_resource type="Script" path="res://combat/resources/SubclassDefinition.gd" id="2_path"]

[sub_resource type="Resource" id="Passive_0"]
script = ExtResource("1_passive")
name = "Tender Hands"
description = "Her heals mend a quarter more, and a quarter of what she mends on somebody else comes back to her."
required_level = 5
heal_bonus = 0.25
heal_self_share = 0.25

[sub_resource type="Resource" id="Passive_1"]
script = ExtResource("1_passive")
name = "Second Wind"
description = "A spell of hers landing on an ally gives them two more tiles of movement until the end of their next turn."
required_level = 9
ally_spell_movement = 2

[resource]
script = ExtResource("2_path")
name = "Carer"
description = "Caring for the wounded, Alithia learns how to help her allies recover their fighting spirits fast."
passives = Array[ExtResource("1_passive")]([SubResource("Passive_0"), SubResource("Passive_1")])
