[gd_resource type="Resource" script_class="SubclassDefinition" format=3]

[ext_resource type="Script" path="res://combat/resources/PassiveDefinition.gd" id="1_passive"]
[ext_resource type="Script" path="res://combat/resources/SubclassDefinition.gd" id="2_path"]

[sub_resource type="Resource" id="Passive_0"]
script = ExtResource("1_passive")
name = "Riposte Step"
description = "After a Rapier strike lands, Cyrus can step up to two tiles away in a straight line - in whichever direction he likes - and nothing can react to it."
required_level = 24
step_after = Array[String](["rapier"])
step_tiles = 2

[sub_resource type="Resource" id="Passive_1"]
script = ExtResource("1_passive")
name = "Flanker"
description = "His Rapier lands a quarter harder on anybody standing beside one of his allies."
required_level = 32
flanking_bonus = 0.25
flanking_skills = Array[String](["rapier"])

[sub_resource type="Resource" id="Passive_2"]
script = ExtResource("1_passive")
name = "Ambush Strike"
description = "His first hit on each enemy in a fight - with anything - deals double."
required_level = 41
opener_bonus = 1.0

[sub_resource type="Resource" id="Passive_3"]
script = ExtResource("1_passive")
name = "Afterimage"
description = "While he is in cover, the first attack at him each round strikes an afterimage and misses."
required_level = 54
afterimage = true

[sub_resource type="Resource" id="Passive_4"]
script = ExtResource("1_passive")
name = "Thousand Cuts"
description = "The Rapier is his secondary action as well as a main one, and each Rapier strike after the first in a turn lands a quarter harder."
required_level = 64
secondary_skills = Array[String](["rapier"])
repeat_bonus = 0.25
repeat_skills = Array[String](["rapier"])

[resource]
script = ExtResource("2_path")
name = "Skirmisher"
description = "The rapier. Cyrus strikes first, from the flank, and is gone before it can be answered - and is never quite where the blow lands."
passives = Array[ExtResource("1_passive")]([SubResource("Passive_0"), SubResource("Passive_1"), SubResource("Passive_2"), SubResource("Passive_3"), SubResource("Passive_4")])
