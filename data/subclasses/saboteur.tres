[gd_resource type="Resource" script_class="SubclassDefinition" format=3]

[ext_resource type="Script" path="res://combat/resources/PassiveDefinition.gd" id="1_passive"]
[ext_resource type="Script" path="res://combat/resources/SubclassDefinition.gd" id="2_path"]

[sub_resource type="Resource" id="Passive_0"]
script = ExtResource("1_passive")
name = "Overload"
description = "A Gun hit of his - any load - makes each of his lingering conditions on the target tick once more, there and then."
required_level = 54
overload = true

[sub_resource type="Resource" id="Passive_1"]
script = ExtResource("1_passive")
name = "Contagion"
description = "As each of their turns starts, whatever he put on somebody spreads to everybody of their side beside them - as strong, and as long, as it began."
required_level = 64
contagion = true

[resource]
script = ExtResource("2_path")
name = "Saboteur"
description = "The ammunition. Cyrus loads rounds that chill and corrode, fires two at once, sets off what is already burning in them - and lets it spread."
skills = Array[String](["frost_round", "corrosive_round", "combined_load"])
passives = Array[ExtResource("1_passive")]([SubResource("Passive_0"), SubResource("Passive_1")])
