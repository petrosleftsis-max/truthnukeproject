[gd_resource type="Resource" script_class="SubclassDefinition" format=3]

[ext_resource type="Script" path="res://combat/resources/PassiveDefinition.gd" id="1_passive"]
[ext_resource type="Script" path="res://combat/resources/SubclassDefinition.gd" id="2_path"]

[sub_resource type="Resource" id="Passive_0"]
script = ExtResource("1_passive")
name = "Ward"
description = "Reaction: when an ally within five tiles - or Prometheus himself - is about to be hit, take four tenths off it."
required_level = 5
wards_allies = true
ward_reduction = 0.4
ward_range = 5

[sub_resource type="Resource" id="Passive_1"]
script = ExtResource("1_passive")
name = "Bulwark Weave"
description = "A spell of his landing on an ally leaves them overhealed: extra health, taken first, gone by the end of the fight."
required_level = 5
overheals_allies = 0.4

[resource]
script = ExtResource("2_path")
name = "Abjurer"
description = "A protective specialization, Prometheus learns ways to further increase his own and others' survivability."
passives = Array[ExtResource("1_passive")]([SubResource("Passive_0"), SubResource("Passive_1")])
