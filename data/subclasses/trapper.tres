[sub_resource type="Resource" id="Passive_0"]
script = ExtResource("1_passive")
name = "Bombardier's Kit"
description = "A Small Bomb to hand in every fight, free - on top of whatever is in his bag. And Steal reaches three tiles further."
required_level = 24
range_bonuses = {
"steal": 3
}
free_item_each_fight = "small_bomb"

[sub_resource type="Resource" id="Passive_1"]
script = ExtResource("1_passive")
name = "Field of Traps"
description = "Two traps set at once, and setting one - Snare or Tripwire - is a secondary action as well as a main one."
required_level = 54
secondary_skills = Array[String](["snare", "tripwire"])
extra_traps = 1

[sub_resource type="Resource" id="Passive_2"]
script = ExtResource("1_passive")
name = "Grand Snare"
description = "Anybody held fast by one of his traps takes a quarter more from him."
required_level = 64
bonus_vs_trapped = 0.25

[resource]
script = ExtResource("2_path")
name = "Trapper"
description = "Bombs and traps. Cyrus never fights a fight that is not already rigged: a bomb in hand, the ground set under them, and whoever walks into it held there."
skills = Array[String](["snare", "tripwire", "minefield"])
passives = Array[ExtResource("1_passive")]([SubResource("Passive_0"), SubResource("Passive_1"), SubResource("Passive_2")])
