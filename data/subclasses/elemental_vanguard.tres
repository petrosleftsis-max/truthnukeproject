[gd_resource type="Resource" script_class="SubclassDefinition" format=3]

[ext_resource type="Script" path="res://combat/resources/PassiveDefinition.gd" id="1_passive"]
[ext_resource type="Script" path="res://combat/resources/SubclassDefinition.gd" id="2_path"]

[sub_resource type="Resource" id="Passive_0"]
script = ExtResource("1_passive")
name = "Fleet Blade"
description = "Light on his feet: two more tiles of movement - and he can Slip Past as a secondary action as well as a main one."
required_level = 24
secondary_skills = Array[String](["slip_past"])
movement_bonus = 2

[sub_resource type="Resource" id="Passive_1"]
script = ExtResource("1_passive")
name = "Spellstrike"
description = "An Edge that lands strikes again with its element - his cantrip of it, x0.7 - and costs nothing more."
required_level = 41
spellstrike = 0.7
spellstrike_skills = Array[String](["flame_edge", "frost_edge", "storm_edge", "stone_edge"])

[sub_resource type="Resource" id="Passive_2"]
script = ExtResource("1_passive")
name = "Elemental Armour"
description = "Wrapped in what he last struck with: a fifth less of that element."
required_level = 54
elemental_armour = 0.2

[sub_resource type="Resource" id="Passive_3"]
script = ExtResource("1_passive")
name = "Avatar"
description = "His Edges hit half as hard again."
required_level = 64
skill_bonuses = {
"flame_edge": 0.5,
"frost_edge": 0.5,
"stone_edge": 0.5,
"storm_edge": 0.5
}

[resource]
script = ExtResource("2_path")
name = "Elemental Vanguard"
description = "The blade. Prometheus closes in, quick on his feet, and fights with swords of fire, ice, storm and stone - each blow a spell."
skills = Array[String](["flame_edge", "frost_edge", "storm_edge", "stone_edge"])
passives = Array[ExtResource("1_passive")]([SubResource("Passive_0"), SubResource("Passive_1"), SubResource("Passive_2"), SubResource("Passive_3")])
