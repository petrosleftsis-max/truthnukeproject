[sub_resource type="Resource" id="Passive_0"]
script = ExtResource("1_passive")
name = "Veil of Mercy I"
description = "Whoever she heals is veiled: the next blow on them lands 15% softer."
required_level = 24
heals_leave = ExtResource("3_veiled")

[sub_resource type="Resource" id="Passive_1"]
script = ExtResource("1_passive")
name = "Veil of Mercy II"
description = "Whoever she heals is blurred too: a fifth less from anything thrown or shot from more than a tile away, until their next turn."
required_level = 32
heals_leave = ExtResource("4_blurred")

[sub_resource type="Resource" id="Passive_2"]
script = ExtResource("1_passive")
name = "Guiding Phantasm"
description = "An image goes ahead of whoever she heals, showing them the way: two more tiles of movement until the end of their next turn."
required_level = 41
heals_spur = 2

[sub_resource type="Resource" id="Passive_3"]
script = ExtResource("1_passive")
name = "Veil of Mercy III"
description = "Her heals leave a shield of light too: a fifth of their health on top of it, for two of their turns."
required_level = 54
heals_shield = 0.2
heals_shield_turns = 2

[sub_resource type="Resource" id="Passive_4"]
script = ExtResource("1_passive")
name = "Illusory Guardian"
description = "While she stands, the first blow each of her side takes in a fight finds only an illusion of them, and misses."
required_level = 64
guards_first_blow = true

[resource]
script = ExtResource("2_path")
name = "Illusory Shepherd"
description = "Protective illusions. Alithia makes cover where there is none, lays phantoms over her friends and fills the field with false targets - and her heals leave a veil behind."
skills = Array[String](["illusory_cover", "phantom_body", "sanctuary_of_light", "mass_mirage", "realitys_reflection"])
passives = Array[ExtResource("1_passive")]([SubResource("Passive_0"), SubResource("Passive_1"), SubResource("Passive_2"), SubResource("Passive_3"), SubResource("Passive_4")])
