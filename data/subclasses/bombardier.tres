range_bonuses = {"steal": 3}
free_item_each_fight = "small_bomb"

[resource]
script = ExtResource("2_path")
name = "Bombardier"
description = "An adaptable style, Cyrus can use more consumables, more efficiently and also more easily steal from enemies."
passives = Array[ExtResource("1_passive")]([SubResource("Passive_0")])
