[gd_resource type="Resource" script_class="SubclassDefinition" format=3]

[ext_resource type="Script" path="res://combat/resources/PassiveDefinition.gd" id="1_passive"]
[ext_resource type="Script" path="res://combat/resources/SubclassDefinition.gd" id="2_path"]
[ext_resource type="Script" path="res://combat/resources/EffectDefinition.gd" id="3_effect"]

[sub_resource type="Resource" id="Effect_study"]
script = ExtResource("3_effect")
type = 9

[sub_resource type="Resource" id="Passive_0"]
script = ExtResource("1_passive")
name = "Inquest"
description = "Reading somebody's next turn studies them too, the way Study does: what they are weak to, and what they are made of."
required_level = 24
on_read_effects = Array[ExtResource("3_effect")]([SubResource("Effect_study")])

[sub_resource type="Resource" id="Passive_1"]
script = ExtResource("1_passive")
name = "Sentence"
description = "Her hits land a quarter harder on anybody whose next turn she has read."
required_level = 41
bonus_vs_read = 0.25

[sub_resource type="Resource" id="Passive_2"]
script = ExtResource("1_passive")
name = "Final Judgment"
description = "Her Judgment goes through all defence, not half, on anybody whose next turn she has read."
required_level = 64
pierce_read_with = Array[String](["judgment"])

[resource]
script = ExtResource("2_path")
name = "Inquisitor"
description = "Reading them. Alithia sees what they will do, says so before everybody - and passes sentence on it, or simply forbids it."
skills = Array[String](["accusation", "recant"])
passives = Array[ExtResource("1_passive")]([SubResource("Passive_0"), SubResource("Passive_1"), SubResource("Passive_2")])
