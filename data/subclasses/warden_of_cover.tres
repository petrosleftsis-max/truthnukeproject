[gd_resource type="Resource" script_class="SubclassDefinition" format=3]

[ext_resource type="Script" path="res://combat/resources/PassiveDefinition.gd" id="1_passive"]
[ext_resource type="Script" path="res://combat/resources/SubclassDefinition.gd" id="2_path"]

[sub_resource type="Resource" id="Passive_0"]
script = ExtResource("1_passive")
name = "Covering Stance"
description = "Her Guard covers the allies beside her too."
required_level = 32
guard_covers = 1

[sub_resource type="Resource" id="Passive_1"]
script = ExtResource("1_passive")
name = "Hold the Line"
description = "Allies inside her Bulwark cannot be shoved or pulled."
required_level = 41
holds_the_line = true

[sub_resource type="Resource" id="Passive_2"]
script = ExtResource("1_passive")
name = "Interceptor"
description = "Half of any hit on an ally within two tiles of her is taken by her instead - Iron Hide III, further."
required_level = 54
guards_within = 2
guard_share = 0.5

[sub_resource type="Resource" id="Passive_3"]
script = ExtResource("1_passive")
name = "Last Wall"
description = "While she stands, no blow fells an ally within two tiles of her: it stops at one point of health, and the rest of it lands on her."
required_level = 64
last_wall = 2

[resource]
script = ExtResource("2_path")
name = "Warden of Cover"
description = "The protector. Enfina stands between her friends and harm - frightening it back, guarding them as she guards herself, and taking what gets through."
skills = Array[String](["shield_bash"])
passives = Array[ExtResource("1_passive")]([SubResource("Passive_0"), SubResource("Passive_1"), SubResource("Passive_2"), SubResource("Passive_3")])
