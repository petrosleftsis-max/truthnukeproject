script = ExtResource("1_ndh0x")
name = "Hermes"
gate = 2
starting_deck = Array[String](["thrust", "thrust", "thrust", "thrust", "guard", "guard", "guard", "guard", "lunge", "twin_cut", "scan"])
starting_relic = "gate_quick_hands"
playstyle = "Fast and light: many cheap cards a turn, drawing as it goes.
The messenger: cards that cost nothing, drawing, and a bonus for every few cards played in a turn (a Relay: every third card draws one). Suggested cards: zero-cost attacks, cards that grow cheaper as the turn goes, a finisher dealing more for every card played this turn. Weak against Overtime and Toll."
