[resource]
script = ExtResource("1_wall")
interactable = false
breakable = true
wall = true
illusion = true
name = "Phantom Wall"
glossary_text = "A wall that is not there: Alithia's illusion. The other side cannot see past it or walk through it, and nothing can hit it. Her own side shoots and walks through it, and whoever of the other side sees that sees through it. Dispel Magic ends it."
