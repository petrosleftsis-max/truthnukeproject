[resource]
script = ExtResource("1_hack")
title = "The Archive Ward"
description = "It stuns whoever it calls an intruder, and wakes the captain. Turn it on its owners - stronger, and reaching further - without moving its sum, or the Demiurge notices."
tries = 3
retry_cost_amount = 8
hint_gate = 1
simplify_gate = 2
sets_off = true
failure_line = "The ward flares - it knows his hand now."
lines = Array[ExtResource("2_line")]([SubResource("Line_targets"), SubResource("Line_wakes"), SubResource("Line_strength"), SubResource("Line_reach"), SubResource("Line_stability")])
edits = 14
balanced = true
