[gd_resource type="Resource" script_class="HackDefinition" format=3]

[ext_resource type="Script" path="res://hacking/HackDefinition.gd" id="1_hack"]
[ext_resource type="Script" path="res://hacking/HackLine.gd" id="2_line"]

[sub_resource type="Resource" id="Line_targets"]
script = ExtResource("2_line")
label = "Targets"
options = Array[String](["Intruders", "Everyone", "Owners"])
cost = 2
pushes = Dictionary[String, int]({
"Stability": -2
})
goal = 3
goal_value = 2

[sub_resource type="Resource" id="Line_strength"]
script = ExtResource("2_line")
label = "Strength"
value = 4
maximum = 9
pushes = Dictionary[String, int]({
"Reach": -1,
"Stability": -1
})
goal = 2
goal_value = 7

[sub_resource type="Resource" id="Line_reach"]
script = ExtResource("2_line")
