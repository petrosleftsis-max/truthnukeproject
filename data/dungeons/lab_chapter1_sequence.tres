[resource]
script = ExtResource("1_dungeon")
display_name = "Laboratory: late Chapter I, Erysichthon (test harness)"
description = "TEST HARNESS, not story content (docs/chapter1_audit.md, section 7). The whole party at 18 through three fights with a short rest between each (half of what was lost back; no gates but what Prometheus's Meditate brings; the fallen stay down unless Resuscitated at the rest, or brought round in a fight with Cyrus's Smelling Salts), with a kit of consumables filling every belt slot, used up as it goes: the City Fight's enemies at 16, the Hired Blades at 17, Erysichthon at 18 - the primary boss variant; the Ash Warden variant is lab_chapter1_sequence_ash_warden.tres. What health is not given back, the fallen, spent gates and used items carry forward. Every fight is logged (LabMetrics). Run it from demos/lab_sequence_conservation.tscn or demos/lab_sequence_free_spending.tscn."
party = Array[String](["enfina", "cyrus", "prometheus", "alithia"])
level = 18
knows_every_spell = true
kit = {
"alithia": ["communion_gate_nade", "heal_gate_nade", "mediocre_cure_potion", "medicine"],
"cyrus": ["small_bomb", "smelling_salts", "blinding_bomb", "mediocre_cure_potion"],
"enfina": ["mediocre_cure_potion", "mediocre_cure_potion", "cure_potion", "medicine"],
"prometheus": ["medicine", "medicine", "mediocre_cure_potion", "fireball_gate_nade"]
}
stages = Array[ExtResource("2_stage")]([SubResource("Stage_a"), SubResource("Stage_b"), SubResource("Stage_c")])
short_rests = true
logs_metrics = true
