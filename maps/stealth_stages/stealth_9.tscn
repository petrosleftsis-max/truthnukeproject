[node name="SignFight" type="Node2D" parent="." unique_id=1274919763]
position = Vector2(11904, 1664)
script = ExtResource("8_36tr8")
text = "A FIGHT, Underground, for what only happens in one. Fire and lightning light the way as they fly, and flare where they land. Somebody burning gives light, as does burning ground. Prometheus's Light Void and Alithia's Phantom Wall take it away: a Phantom Wall stops light as a wall does. His Illusory Dragon gives light, though it is not there. Break the brazier and watch its light ease out. Rats will not walk beside fire. Prometheus knows every spell here, and Alithia has the Illusory Shepherd's. Right click what a tether holds to end it."
prompt = "Read"
interaction_radius = 320.0
sprite_frames = ExtResource("7_wdnkf")

