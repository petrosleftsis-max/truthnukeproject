[node name="SignMagic" type="Node2D" parent="." unique_id=2010145188]
position = Vector2(11136, 6016)
script = ExtResource("8_36tr8")
text = "Alithia's DETECT MAGIC, from the panel (Spells): for five minutes every ward, magic sensor and magical trap on the map has a ring round it, wherever it is. Her ARCANE EYE, through the Gates of Mnemosyne, is an eye to steer that nothing notices. Mind the glyph: it fires."
prompt = "Read"
interaction_radius = 320.0
sprite_frames = ExtResource("7_wdnkf")

